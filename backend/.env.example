# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_64_char_random_string

# ─── SQL Server ───────────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CoffeeToGo
DB_USER=coffeetogo_app
DB_PASSWORD=change_me_to_a_strong_password

# Set to false only when using a self-signed certificate on localhost (dev):
DB_ENCRYPT=true
# Set to true when using a self-signed cert on localhost:
DB_TRUST_CERT=false

# ─── CORS / Socket.IO ────────────────────────────────────────────────────────
# In production, restrict to your actual domain(s).
CORS_ORIGIN=https://yourdomain.vn

